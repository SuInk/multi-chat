{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "允许主窗口向任意 http(s) 接口发请求：平台地址由用户自行填写",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*:*" }, { "url": "http://*:*" }]
    }
  ]
}

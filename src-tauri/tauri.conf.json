{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "multi-chat",
  "version": "0.1.1",
  "identifier": "io.github.suink.multichat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8090",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "multi-chat",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "13.0" },
    "iOS": { "minimumSystemVersion": "16.0" }
  }
}
